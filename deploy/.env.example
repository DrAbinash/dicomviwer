# DICOM Viewer deployment secrets - copy to .env next to docker-compose.yml
#   cp .env.example .env   (then edit)

# ---------------------------------------------------------------------------
# Viewer login (Phase 2). CHANGE THE DEFAULTS BEFORE FIRST DEPLOYMENT.
# The username/password can also be changed later in Settings > Security
# (stored hashed in the viewer database, overriding these env values).
# ---------------------------------------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Session signing secret - any long random string. Generate with:
#   openssl rand -hex 32
# Keep it stable across restarts so logins survive container rebuilds.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# DICOM gateway (Orthanc)
# ---------------------------------------------------------------------------

# AE Title of THIS gateway. Remote PACS that only support C-MOVE must have
# this AE Title + this NAS IP + DICOM port 4242 registered on their side.
# Also used as the auto-puller's C-MOVE target (TARGET_AET).
ORTHANC_AE_TITLE=ORTHANC2

# Human-readable Orthanc name (shown in the Settings > Gateway panel)
ORTHANC_NAME=CareDiagnostics

# Orthanc web credentials (also used by the viewer and the auto-puller)
ORTHANC_USER=viewer
ORTHANC_PASSWORD=change-me-strong

# Optional: only needed if the viewer runs OUTSIDE the compose stack
# ORTHANC_URL=http://192.168.1.50:8042
# GATEWAY_AET=ORTHANC2

# ---------------------------------------------------------------------------
# Phase 2 auto-puller (polls modalities, pulls missing studies)
# ---------------------------------------------------------------------------

# Which modalities to poll. Empty = every modality registered on Orthanc.
# Comma list with optional :on/:off flags:
#   AUTO_PULL_MODALITIES=UIH_MRI:on,CT_MACHINE:on,XRAY_1:off
AUTO_PULL_MODALITIES=

# Seconds between poll cycles (default 300 = 5 minutes)
AUTO_PULL_INTERVAL=300

# How many days back to query for studies (default 1)
AUTO_PULL_LOOKBACK_DAYS=1

# Safety cap: max study retrieves started per cycle (default 20)
AUTO_PULL_MAX_RETRIEVES=20

# Minutes before a failed study is retried (default 30)
AUTO_PULL_COOLDOWN=30

# Shared secret the puller sends with its heartbeat. Set the same value in
# the viewer container (AUTO_PULL_TOKEN) - when non-empty, unauthenticated
# heartbeats are rejected. Generate with: openssl rand -hex 16
AUTO_PULL_TOKEN=

# DEBUG / INFO / WARNING
AUTO_PULL_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# HTTPS (Caddy)
# ---------------------------------------------------------------------------

# LAN use (self-signed): leave localhost. Public use (Synology DDNS):
# set to yourname.synology.me and forward only 443 to this host.
ACME_HOSTNAME=localhost

# ---------------------------------------------------------------------------
# Phase 3.5 built-in DICOM listener (the viewer as a PACS node)
# ---------------------------------------------------------------------------

# Host port for the viewer's built-in C-STORE listener. Keep this identical
# to the port configured in Settings > PACS > DICOM listener (default 4104).
# Modalities / other PACS push studies to <NAS-IP>:<DVV_LISTEN_PORT>.
DVV_LISTEN_PORT=4104
