{
  "Name": "CareDiagnostics",
  "DicomAet": "ORTHANC2",
  "DicomPort": 4242,
  "HttpPort": 8042,

  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,

  "_Comment_Modalities": "Site PACS nodes seeded at FIRST start (DicomModalitiesInDatabase imports them, then the viewer Settings UI manages them via REST - add/edit/delete IP, AE Title and port from the browser). Replace the IPs/ports with your site values or manage them entirely from Settings.",

  "DicomModalities": {
    "UIH_MRI": ["UIH", "172.16.1.103", 3333],
    "CT_MACHINE": ["ct99", "172.16.1.99", 4006],
    "weasis-clinic": ["weasis123", "172.16.1.140", 11113],
    "weasis-su": ["weasissu", "172.16.1.141", 11113],
    "GE-Voluson-E9": ["Voluson", "172.16.1.46", 104],
    "XRAY_1": ["film plus", "172.16.1.80", 105],
    "XRAY_2": ["film plus", "172.16.1.90", 105]
  },

  "DicomModalitiesInDatabase": true,

  "DicomAlwaysAllowStore": true,
  "DicomCheckCalledAet": false,
  "DicomScpEnabled": true,
  "DicomScuEnabled": true,

  "DicomAssociationEchoTimeout": 10,
  "DicomAssociationTimeout": 30,

  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false,
    "StowMaxInstantSize": 10
  },

  "Worklists": {
    "Enable": true,
    "Database": "/var/lib/orthanc/db/worklists",
    "SetStudyInstanceUidIfMissing": true,
    "DeleteWorklistsOnStableStudy": true
  },

  "OrthancPeers": {},

  "DefaultEncoding": "Latin1",
  "DeflatedDataDirectory": "/var/lib/orthanc/db",
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",

  "MaximumStorageSize": 0,
  "MaximumPatientCount": 0,

  "JobsHistorySize": 10,

  "LimitFindResults": 0,
  "LimitFindInstances": 0,
  "LimitJobs": 10
}
