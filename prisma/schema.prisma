// Prisma schema for DICOM Viewer
// - PacsServer: user-managed remote PACS connections (AE Title / IP / Port)
// - AppSetting: key-value store for gateway (Orthanc) connection settings
// - AutoPullEvent: activity log written by the Phase 2 auto-puller service
//   (each detected study = pulled / skipped / failed) via its heartbeat POST

generator client {
  provider = "prisma-client-js"
  // "native" covers Linux (dev / Docker image); "windows" ships the Windows
  // query engine so the standalone build also runs on Windows (offline
  // deployment package, START-VIEWER.bat).
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PacsServer {
  id         String    @id @default(cuid())
  name       String // friendly label, e.g. "Hospital CT PACS"
  aeTitle    String    @unique // DICOM AE Title, max 16 chars (validated in app)
  host       String // IP address or hostname
  port       Int       @default(104) // DICOM listen port
  notes      String?
  lastStatus String? // "ok" | "fail" — last C-ECHO result
  lastTestAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AutoPullEvent {
  id              String   @id @default(cuid())
  sourceAet       String // modality the study was pulled from, e.g. UIH_MRI
  studyUid        String
  patientName     String   @default("")
  patientId       String   @default("")
  studyDescription String  @default("")
  accessionNumber String   @default("")
  action          String // "pulled" | "skipped" | "failed"
  detail          String   @default("") // error text or skip reason
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([sourceAet, createdAt])
  @@index([studyUid])
}

// Saved measurements (GSPS-style overlay state) for one series of one study.
// payload = Cornerstone3D annotation.state JSON for the series, stored
// verbatim so it can be restored losslessly (Phase 3).
model AnnotationSet {
  id        String   @id @default(cuid())
  studyUid  String
  seriesUid String
  payload   String // JSON blob of annotation objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyUid, seriesUid])
  @@index([studyUid])
}

// ---------------------------------------------------------------------------
// Built-in PACS node (Phase 3.5) — studies received via the native DICOM
// listener (C-STORE SCP). Files live on disk under db/dicom-received/
// (<studyUid>/<sopUid>.dcm); these tables are the queryable index.
// ---------------------------------------------------------------------------

model ReceivedStudy {
  id               String   @id @default(cuid())
  studyUid         String   @unique
  sourceAet        String   @default("") // calling AE Title of the sender
  patientName      String   @default("")
  patientId        String   @default("")
  patientBirthDate String   @default("")
  patientSex       String   @default("")
  studyDate        String   @default("") // YYYYMMDD
  studyDescription String   @default("")
  accessionNumber  String   @default("")
  modalities       String   @default("") // comma-joined ModalitiesInStudy
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientName])
  @@index([studyDate])
}

model ReceivedSeries {
  id            String   @id @default(cuid())
  seriesUid     String   @unique
  studyUid      String
  seriesNumber  Int      @default(1)
  description   String   @default("")
  modality      String   @default("")
  instanceCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([studyUid])
}

model ReceivedInstance {
  id             String   @id @default(cuid())
  sopUid         String   @unique
  studyUid       String
  seriesUid      String
  instanceNumber Int      @default(0)
  filePath       String // absolute path of the stored .dcm file
  bytes          Int      @default(0)
  receivedAt     DateTime @default(now())

  @@index([studyUid, seriesUid])
}
